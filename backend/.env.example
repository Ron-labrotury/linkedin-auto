# Copy to .env (or set in your host's dashboard). Only APP_SECRET is required in production.
APP_SECRET=change-me-to-a-long-random-string
PORT=8787
DATA_DIR=./data
# Comma-separated frontend origins allowed to call the API, or *
CORS_ORIGIN=*
# playwright = real LinkedIn in a headless browser; simulated = fake LinkedIn for local testing
LINKEDIN_DRIVER=playwright
HEADLESS=true
# How many LinkedIn browser sessions may stay open at once (each ~150–300 MB of memory)
MAX_BROWSER_CONTEXTS=3
# Reverse proxies in front of the app (1 on Render/Railway/Fly). Use false when exposed directly.
TRUST_PROXY=1
# Public URL of the frontend (used in team invite links)
PUBLIC_APP_URL=
